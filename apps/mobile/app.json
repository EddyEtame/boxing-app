{
  "expo": {
    "name": "Boxing Center",
    "slug": "boxing-center",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "boxingcenter",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F2EE",
    "primaryColor": "#E8001C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.boxingcenter.app",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": [
          "fr",
          "en"
        ],
        "NSLocationWhenInUseUsageDescription": "Boxing Center utilise ta position pour les clubs proches, seulement si tu l'autorises.",
        "NSPhotoLibraryUsageDescription": "Boxing Center lit tes documents et photos seulement pour les enregistrer dans l'application.",
        "NSPhotoLibraryAddUsageDescription": "Boxing Center enregistre tes documents et factures sur cet appareil."
      }
    },
    "android": {
      "package": "fr.boxingcenter.app",
      "adaptiveIcon": {
        "backgroundColor": "#F4F2EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_WIFI_STATE",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F2EE",
          "image": "./assets/brand/logo-transparent-600.png",
          "imageWidth": 168,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0D1120",
            "image": "./assets/brand/logo-sticker-750.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "fr",
              "en"
            ],
            "android": [
              "fr",
              "en"
            ]
          }
        }
      ],
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Boxing Center utilise Face ID pour confirmer que c'est bien toi avant d'afficher ton badge."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#E8001C",
          "defaultChannel": "default",
          "enableRemoteNotifications": false,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-background-task",
      "expo-sharing",
      "./plugins/sans-firebase-init.js",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://de.sentry.io/",
          "project": "boxing-center",
          "organization": "fareno-corps",
          "disableAutoUpload": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "924094d8-ad74-48c0-af31-b2b44935e553"
      }
    },
    "owner": "raphaelangoula"
  }
}
