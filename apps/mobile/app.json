{
  "expo": {
    "name": "Boxing Center",
    "slug": "boxing-center",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "boxingcenter",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F4F2EE",
    "primaryColor": "#E8001C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fr.boxingcenter.app",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "fr",
        "CFBundleLocalizations": [
          "fr",
          "en"
        ]
      }
    },
    "android": {
      "package": "fr.boxingcenter.app",
      "adaptiveIcon": {
        "backgroundColor": "#20254B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F2EE",
          "image": "./assets/brand/logo-transparent-600.png",
          "imageWidth": 168,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#0D1120",
            "image": "./assets/brand/logo-sticker-750.png"
          }
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["fr", "en"],
            "android": ["fr", "en"]
          }
        }
      ],
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Boxing Center utilise Face ID pour confirmer que c'est bien toi avant d'afficher ton badge."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#E8001C",
          "defaultChannel": "default",
          "enableRemoteNotifications": false,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-background-task",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
