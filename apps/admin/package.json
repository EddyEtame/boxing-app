{
  "name": "admin",
  "version": "0.0.0",
  "private": true,
  "description": "Interface d'administration Boxing Center (CDC §15) : la web-app de la direction, branchée sur l'app, Deciplus, la boutique et les plannings.",
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start --port 3001",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "node --experimental-strip-types --import ./test/hooks.mjs --test test/*.test.ts",
    "env:boutique": "tsx scripts/env-boutique.ts",
    "seed:events": "tsx scripts/seed-events.ts",
    "seed:events:clear": "tsx scripts/seed-events.ts --clear",
    "backup": "tsx scripts/backup.ts"
  },
  "dependencies": {
    "@bc/brand": "*",
    "@bc/contract": "*",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "~8.71.2"
  }
}
