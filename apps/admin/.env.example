# Interface d'administration Boxing Center — modèle de apps/admin/.env.local
# Noms seulement : aucune valeur réelle ici. `npm run env:boutique --workspace apps/admin`
# remplit .env.local à partir de la boutique, sans jamais afficher les valeurs.

# Le compte Direction : les mêmes identifiants que le super administrateur de la boutique (box-plus).
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Signature des cookies de session (64 caractères hexadécimaux, généré par le script).
SESSION_SECRET=

# Facultatif — où l'admin garde ses fichiers JSON (par défaut apps/admin/.data).
ADMIN_DATA_DIR=

# Facultatif — origines web supplémentaires autorisées à lire l'API publique (séparées par des virgules).
ADMIN_CORS_ORIGINS=

# En production, derrière un proxy qui réécrit X-Forwarded-For : 1. Sinon, laissé vide (les en-têtes de proxy sont ignorés).
TRUST_PROXY=

# Facultatif — branchements (page « Branchements ») : laissés vides tant que la pièce n'existe pas.
DECIPLUS_BRIDGE_URL=
# Legacy : /health du bridge n'exige pas ce secret ; une valeur quelconque suffit si l'URL est renseignée.
DECIPLUS_BRIDGE_SECRET=
# Pont membre (checkout app, orphelins boutique) : même URL que DECIPLUS_BRIDGE_URL en pratique.
MEMBER_BRIDGE_URL=
# Secret HMAC pour POST /internal/admin/* (identique à apps/bridge ADMIN_BRIDGE_SECRET).
ADMIN_BRIDGE_SECRET=
EXPO_ACCESS_TOKEN=
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_TOKEN=
SENTRY_DSN=
SUPABASE_URL=
# Adresse publique de la boutique (vérifiée par une requête HEAD) et fil des combats (CDC §13).
BOUTIQUE_URL=
COMBATS_FEED_URL=
