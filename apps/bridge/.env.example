# Port HTTP (defaut 8080)
PORT=

# Hote d'ecoute (defaut 0.0.0.0)
HOST=

# URL publique https du bridge, via le tunnel Cloudflare
PUBLIC_URL=

# Projet Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Robot BOXPLUS sur la meme machine (defaut http://127.0.0.1:3050)
BOT_URL=
BOT_SYNC_SECRET=

# Signature HMAC des retours du robot
APP_BRIDGE_SECRET=

# Signature HMAC des decisions de l'admin
ADMIN_BRIDGE_SECRET=

# Crochet Send Email Supabase, format v1,whsec_<base64>
SEND_EMAIL_HOOK_SECRET=

# Cle API Brevo (meme compte que la boutique)
BREVO_API_KEY=

# Expediteur (defaut suzinabot@gmail.com)
BREVO_SENDER_EMAIL=

# Nom affiche (defaut Boxing Center)
BREVO_SENDER_NAME=

# Adresse de reponse (defaut boxingcenter31@gmail.com)
BREVO_REPLY_TO=

# Signature HMAC des evenements boutique -> bridge
SHOP_BRIDGE_SECRET=

# URL de base du tunnel checkout app (query token ajoute par le bridge)
BOUTIQUE_CHECKOUT_BASE_URL=

# Lanceur BotHosting : dossier du robot BOXPLUS (bot/index.js)
ROBOT_DIR=

# Jeton du tunnel Cloudflare, si start.mjs doit le lancer
CLOUDFLARE_TUNNEL_TOKEN=

# Binaire cloudflared (defaut ./bin/cloudflared)
CLOUDFLARED_BIN=
