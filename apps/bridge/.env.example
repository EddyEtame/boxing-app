# Port HTTP (defaut 8080)
PORT=

# Hote d'ecoute (defaut 0.0.0.0)
HOST=

# URL publique https du bridge, via le tunnel Cloudflare
PUBLIC_URL=

# Projet Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Robot BOXPLUS sur la meme machine (defaut http://127.0.0.1:3050)
BOT_URL=
BOT_SYNC_SECRET=

# Signature HMAC des retours du robot
APP_BRIDGE_SECRET=

# Signature HMAC des decisions de l'admin
ADMIN_BRIDGE_SECRET=

# Crochet Send Email Supabase, format v1,whsec_<base64>
SEND_EMAIL_HOOK_SECRET=

# Cle API Brevo (meme compte que la boutique)
BREVO_API_KEY=

# Expediteur (domaine boxingcenter.fr authentifie dans Brevo)
BREVO_SENDER_EMAIL=contact@boxingcenter.fr

# Nom affiche
BREVO_SENDER_NAME=Boxing Center

# Reponses (hors Portet). Portet : BREVO_REPLY_TO_PORTET n'est pas utilise ici.
BREVO_REPLY_TO=boxingcenter31@gmail.com

# Signature HMAC des evenements boutique -> bridge
SHOP_BRIDGE_SECRET=

# URL de base du tunnel checkout app (query token ajoute par le bridge)
BOUTIQUE_CHECKOUT_BASE_URL=

# Admin Next sur la meme machine (le bridge relaie /api/* vers cette origine)
ADMIN_INTERNAL_URL=

# Dossier apps/admin si start.mjs doit aussi lancer l'admin
ADMIN_APP_DIR=

# Lanceur BotHosting : dossier du robot BOXPLUS (bot/index.js)
ROBOT_DIR=

# Jeton du tunnel Cloudflare, si start.mjs doit le lancer
CLOUDFLARE_TUNNEL_TOKEN=

# Binaire cloudflared (defaut ./bin/cloudflared)
CLOUDFLARED_BIN=

# Projet Sentry boxing-center-bridge. Vide = pas d'envoi.
SENTRY_DSN=
# Projet Sentry boxing-center-admin, seulement si start.mjs lance aussi Next.
ADMIN_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
